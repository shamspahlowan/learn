---
interface Props { type?: string }
const { type = 'article' } = Astro.props;
const tone: Record<string, string> = { video: 'indigo', course: 'sage', book: 'amber', docs: 'slate', article: 'slate', paper: 'plum', repo: 'slate', exercises: 'amber', tool: 'sage', do: 'amber' };
---
<span class={`ri t-${tone[type] ?? 'slate'}`} aria-hidden="true">
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {type === 'video' && <path d="M8 5v14l11-7z"></path>}
    {type === 'course' && <><path d="M2 9l10-5 10 5-10 5z"></path><path d="M6 11v5c3 2 9 2 12 0v-5"></path></>}
    {type === 'book' && <><path d="M4 5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2z"></path><path d="M4 19V5"></path></>}
    {(type === 'docs' || type === 'article') && <><path d="M14 3H6v18h12V7z"></path><path d="M14 3v4h4M9 12h6M9 16h6"></path></>}
    {type === 'paper' && <><path d="M6 3h9l3 3v15H6z"></path><path d="M9 9h6M9 13h6M9 17h3"></path></>}
    {type === 'repo' && <><circle cx="6" cy="6" r="2"></circle><circle cx="6" cy="18" r="2"></circle><circle cx="18" cy="8" r="2"></circle><path d="M6 8v8M18 10c0 4-6 3-10 6"></path></>}
    {(type === 'exercises' || type === 'do') && <path d="m8 9-4 3 4 3M16 9l4 3-4 3M13 6l-2 12"></path>}
    {type === 'tool' && <path d="M14 6a4 4 0 0 0 5 5l-8 8a2 2 0 0 1-3-3z"></path>}
  </svg>
</span>
<style>
  .ri { width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; flex: none; }
  .t-indigo { background: var(--indigo-soft); color: var(--indigo); }
  .t-sage { background: var(--sage-soft); color: var(--sage); }
  .t-amber { background: var(--amber-soft); color: var(--amber); }
  .t-plum { background: var(--plum-soft); color: var(--plum); }
  .t-slate { background: var(--slate-soft); color: var(--slate); }
</style>
