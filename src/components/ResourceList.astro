---
import { hostOf } from '../lib/courses';

interface Res { t: string; type?: string; url?: string; free?: boolean; via?: string; note?: string }
interface Props { items: Res[]; practice?: boolean }
const { items, practice = false } = Astro.props;
const label: Record<string, string> = { video: 'Video', course: 'Course', book: 'Book', docs: 'Docs', article: 'Article', paper: 'Paper', repo: 'Repo', exercises: 'Exercises', tool: 'Tool' };
---
<ul class:list={['res', { practice }]}>
  {items.map((r) => (
    <li>
      <span class="type mono">{practice ? 'Do' : label[r.type ?? ''] ?? r.type}</span>
      <div class="what">
        {r.url ? <a href={r.url} rel="noopener">{r.t}<span class="host mono"> · {hostOf(r.url)} ↗</span></a> : <span>{r.t}</span>}
        {(r.note || r.free === false || r.via === 'community') && (
          <span class="meta">
            {r.free === false && <span class="paid">paid</span>}
            {r.via === 'community' && <span class="comm">community pick</span>}
            {r.note && <span>{r.note}</span>}
          </span>
        )}
      </div>
    </li>
  ))}
</ul>
<style>
  .res { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  li { display: grid; grid-template-columns: 74px minmax(0, 1fr); gap: 12px; padding: 10px 0; border-top: 1px solid var(--line-soft); font-size: 14.5px; line-height: 1.45; }
  li:first-child { border-top: 0; }
  .type { font-size: 11px; color: var(--muted); padding-top: 3px; text-transform: uppercase; letter-spacing: .06em; }
  .practice .type { color: var(--amber); }
  .what { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .what a { color: var(--fg); }
  .what a:hover { color: var(--accent); }
  .host { font-size: 11.5px; color: var(--muted); }
  .meta { display: flex; gap: 8px; flex-wrap: wrap; font-size: 12.5px; color: var(--muted); }
  .paid { color: var(--coral); }
  .comm { color: var(--sage); }
</style>
