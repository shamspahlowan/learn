---
import Base from '../layouts/Base.astro';
import { allCourses, lessonsOf, PATHS } from '../lib/courses';

const courses = await allCourses();
const catalog = {
  lessons: courses.flatMap((c) => lessonsOf(c).map((l) => ({ c: c.slug, s: l.slug, t: l.title, n: l.number, ct: c.title }))),
  paths: PATHS.map((p) => ({ slug: p.slug, title: p.title, courses: p.courses })),
};
---
<Base title="Tracker" noindex>
  <script type="application/json" id="catalog" set:html={JSON.stringify(catalog)} />
  <div class="wrap page">
    <div class="bar">
      <span class="lock"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>Only the owner can see this</span>
      <button class="btn small" id="sign-out" type="button" hidden>Sign out</button>
    </div>

    <section id="v-loading" class="center"><p class="muted">Checking your session…</p></section>

    <section id="v-signin" class="center" hidden>
      <h1>Tracker</h1>
      <p class="muted">Sign in with GitHub to see your progress, reviews and journal.</p>
      <button class="btn primary" id="sign-in" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z"></path></svg>
        Sign in with GitHub
      </button>
      <p class="muted small" id="signin-error" role="alert"></p>
    </section>

    <section id="v-denied" class="center" hidden>
      <h1>This tracker is private</h1>
      <p class="muted">It belongs to the site's owner. Your account can't see or change anything here.</p>
    </section>

    <section id="v-dash" hidden>
      <header class="hello">
        <div>
          <span class="mono muted" id="today-line"></span>
          <h1>Good <span id="part-of-day">day</span>, <span class="serif-em">Shams</span></h1>
        </div>
      </header>

      <div class="stats">
        <div class="stat"><span class="muted">Reviews due</span><b id="s-due">0</b><span class="small" id="s-due-sub"></span></div>
        <div class="stat"><span class="muted">This week</span><b><span id="s-week">0</span><small> h</small></b><span class="small muted" id="s-week-sub"></span></div>
        <div class="stat"><span class="muted">Streak</span><b><span id="s-streak">0</span><small> days</small></b><span class="small muted" id="s-best"></span></div>
        <div class="stat ink"><span>Lessons done</span><b><span id="s-done">0</span><small> / <span id="s-total"></span></small></b><div class="meter"><i id="s-done-bar"></i></div></div>
      </div>

      <div class="two">
        <section class="card box">
          <div class="bh"><h2>Review queue</h2><span class="muted small" id="rq-count"></span></div>
          <ol class="rows" id="review-list"></ol>
        </section>
        <section class="box timer">
          <span class="eyebrow ac">Focus timer</span>
          <svg width="170" height="170" viewBox="0 0 170 170" role="img" aria-label="Focus timer">
            <circle cx="85" cy="85" r="74" fill="none" class="t-track" stroke-width="8"></circle>
            <circle cx="85" cy="85" r="74" fill="none" class="t-arc" stroke-width="8" stroke-linecap="round" stroke-dasharray="465 465" stroke-dashoffset="0" transform="rotate(-90 85 85)" id="t-arc"></circle>
            <text x="85" y="94" text-anchor="middle" class="t-num" id="t-num">25:00</text>
          </svg>
          <div class="trow">
            <button class="btn small primary" type="button" id="t-start">Start</button>
            <button class="btn small" type="button" id="t-reset">Reset</button>
          </div>
          <p class="small ac">A finished 25-minute session logs itself to your journal.</p>
        </section>
      </div>

      <div class="two">
        <section class="card box">
          <div class="bh"><h2>Study activity</h2><span class="mono muted small" id="heat-sum"></span></div>
          <div class="heat" id="heat" role="img" aria-label="Study minutes per day over the last 26 weeks"></div>
          <div class="legend small muted">less <i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i> more</div>
        </section>
        <section class="card box">
          <h2>Paths</h2>
          <div id="paths" class="paths"></div>
          <div class="weak">
            <span class="small muted">Weak spots (confidence 2 or below)</span>
            <div id="weak" class="chips"></div>
          </div>
        </section>
      </div>

      <div class="two">
        <section class="card box">
          <div class="bh"><h2>In progress</h2></div>
          <ol class="rows" id="learning-list"></ol>
        </section>
        <section class="card box">
          <h2>Log a session</h2>
          <form id="log-form" class="logf">
            <label for="lf-min">Minutes</label>
            <input id="lf-min" type="number" min="5" max="600" step="5" value="45" required />
            <label for="lf-note">What did you do?</label>
            <textarea id="lf-note" rows="3" placeholder="Finished SVD lesson, did 2 NeetCode graphs"></textarea>
            <button class="btn small primary" type="submit">Log session</button>
            <span class="small muted" id="lf-status" aria-live="polite"></span>
          </form>
        </section>
      </div>

      <section class="card box">
        <div class="bh"><h2>Journal</h2></div>
        <ol class="rows journal" id="journal"></ol>
      </section>
    </section>
  </div>
</Base>

<script>
  import { supa, getOwner, REVIEW_STEPS, addDays, isoDay } from '../scripts/supa';

  type L = { c: string; s: string; t: string; n: string; ct: string };
  const catalog = JSON.parse(document.getElementById('catalog')!.textContent!) as { lessons: L[]; paths: { slug: string; title: string; courses: string[] }[] };
  const byKey = new Map(catalog.lessons.map((l) => [`${l.c}/${l.s}`, l]));
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const show = (id: string) => ['v-loading', 'v-signin', 'v-denied', 'v-dash'].forEach((v) => ($(v).hidden = v !== id));
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const lessonLink = (c: string, s: string) => `${base}/courses/${c}/${s}/`;

  $('sign-in').addEventListener('click', async () => {
    const { error } = await supa.auth.signInWithOAuth({ provider: 'github', options: { redirectTo: location.origin + location.pathname } });
    if (error) $('signin-error').textContent = /provider is not enabled/i.test(error.message)
      ? 'GitHub sign-in is not switched on in Supabase yet. Follow the setup steps in the README.'
      : `Sign-in failed: ${error.message}`;
  });
  $('sign-out').addEventListener('click', () => { supa.auth.signOut(); });

  async function boot() {
    if (location.hash === '#' || location.hash.includes('access_token')) history.replaceState(null, '', location.pathname);
    const { data } = await supa.auth.getSession();
    if (!data.session) { show('v-signin'); return; }
    $('sign-out').hidden = false;
    const owner = await getOwner();
    if (!owner) { show('v-denied'); return; }
    show('v-dash');
    await refresh();
  }

  async function refresh() {
    const now = new Date();
    const h = now.getHours();
    $('part-of-day').textContent = h < 12 ? 'morning' : h < 17 ? 'afternoon' : 'evening';
    $('today-line').textContent = now.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'short' });

    const since = addDays(-7 * 26);
    const [{ data: progress }, { data: journal }] = await Promise.all([
      supa.from('lesson_progress').select('*').order('updated_at', { ascending: false }),
      supa.from('journal_entries').select('*').gte('day', since).order('created_at', { ascending: false }),
    ]);
    const prog = progress ?? [];
    const jr = journal ?? [];
    const today = isoDay();

    // Reviews
    const due = prog.filter((p) => p.status === 'done' && p.next_review_at && p.next_review_at <= today).sort((a, b) => a.next_review_at.localeCompare(b.next_review_at));
    $('s-due').textContent = String(due.length);
    $('s-due-sub').textContent = due.length ? `oldest from ${new Date(due[0].next_review_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}` : 'all caught up';
    $('rq-count').textContent = due.length ? `${due.length} due` : '';
    $('review-list').innerHTML = due.length ? due.slice(0, 8).map((p) => {
      const l = byKey.get(`${p.course}/${p.lesson}`);
      return `<li class="rrow"><div><a href="${lessonLink(p.course, p.lesson)}">${esc(l?.t ?? p.lesson)}</a><span class="small muted">${esc(l?.ct ?? p.course)} · ${l?.n ?? ''} · review ${p.review_step + 1}</span></div>
        <div class="ra"><button class="btn small" data-again="${p.course}|${p.lesson}">Again</button><button class="btn small primary" data-got="${p.course}|${p.lesson}|${p.review_step}">Got it</button></div></li>`;
    }).join('') : '<li class="emptyrow muted">Nothing to review. Finish a lesson and it will come back here tomorrow.</li>';

    // Hours this week (Monday start) and streak
    const minutesBy = new Map<string, number>();
    jr.forEach((e) => minutesBy.set(e.day, (minutesBy.get(e.day) ?? 0) + e.minutes));
    const monday = new Date(now); monday.setDate(now.getDate() - ((now.getDay() + 6) % 7));
    const mondayIso = isoDay(monday);
    const weekMin = jr.filter((e) => e.day >= mondayIso).reduce((s, e) => s + e.minutes, 0);
    $('s-week').textContent = (Math.round((weekMin / 60) * 10) / 10).toString();
    $('s-week-sub').textContent = `${jr.filter((e) => e.day >= mondayIso).length} sessions`;
    let streak = 0; const d = new Date(now);
    if (!minutesBy.get(isoDay(d))) d.setDate(d.getDate() - 1);
    while (minutesBy.get(isoDay(d))) { streak++; d.setDate(d.getDate() - 1); }
    let best = 0, run = 0;
    for (let i = 7 * 26; i >= 0; i--) { if (minutesBy.get(addDays(-i))) { run++; best = Math.max(best, run); } else run = 0; }
    $('s-streak').textContent = String(streak);
    $('s-best').textContent = `best: ${best}`;

    // Lessons done
    const done = prog.filter((p) => p.status === 'done');
    $('s-done').textContent = String(done.length);
    $('s-total').textContent = String(catalog.lessons.length);
    $<HTMLElement>('s-done-bar').style.width = `${Math.min(100, (done.length / catalog.lessons.length) * 100)}%`;

    // Heatmap: 26 weeks, columns are weeks starting Monday
    const start = new Date(monday); start.setDate(start.getDate() - 7 * 25);
    let cells = '', total = 0;
    for (let i = 0; i < 26 * 7; i++) {
      const day = new Date(start); day.setDate(start.getDate() + i);
      const key = isoDay(day);
      const m = minutesBy.get(key) ?? 0; total += m;
      const lvl = key > today ? 'future' : m === 0 ? 'l0' : m < 45 ? 'l1' : m < 120 ? 'l2' : 'l3';
      cells += `<i class="${lvl}" title="${day.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}: ${m} min"></i>`;
    }
    $('heat').innerHTML = cells;
    $('heat-sum').textContent = `last 26 weeks · ${Math.round(total / 60)} h`;

    // Paths
    const doneSet = new Set(done.map((p) => p.course + '/' + p.lesson));
    $('paths').innerHTML = catalog.paths.map((p) => {
      const ls = catalog.lessons.filter((l) => p.courses.includes(l.c));
      const n = ls.filter((l) => doneSet.has(`${l.c}/${l.s}`)).length;
      const pct = ls.length ? Math.round((n / ls.length) * 100) : 0;
      return `<div class="prow"><div class="pt"><span>${esc(p.title)}</span><span class="mono small muted">${n}/${ls.length} · ${pct}%</span></div><div class="meter soft"><i style="width:${pct}%"></i></div></div>`;
    }).join('');

    const weak = prog.filter((p) => p.confidence && p.confidence <= 2);
    $('weak').innerHTML = weak.length ? weak.map((p) => `<a class="wchip" href="${lessonLink(p.course, p.lesson)}">${esc(byKey.get(`${p.course}/${p.lesson}`)?.t ?? p.lesson)}</a>`).join('') : '<span class="small muted">None. Rate your confidence on each lesson page.</span>';

    const learning = prog.filter((p) => p.status === 'learning');
    $('learning-list').innerHTML = learning.length ? learning.slice(0, 8).map((p) => {
      const l = byKey.get(`${p.course}/${p.lesson}`);
      return `<li class="rrow"><div><a href="${lessonLink(p.course, p.lesson)}">${esc(l?.t ?? p.lesson)}</a><span class="small muted">${esc(l?.ct ?? p.course)} · ${l?.n ?? ''}</span></div></li>`;
    }).join('') : `<li class="emptyrow muted">Nothing in progress. <a href="${base}/courses/">Pick a lesson</a> and mark it as learning.</li>`;

    $('journal').innerHTML = jr.length ? jr.slice(0, 12).map((e) => {
      const l = e.course && e.lesson ? byKey.get(`${e.course}/${e.lesson}`) : null;
      return `<li class="jrow"><span class="mono small muted">${new Date(e.day).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' })}</span><span class="jnote">${esc(e.note || (l ? l.t : 'Study session'))}${l ? ` <a class="small" href="${lessonLink(e.course, e.lesson)}">${esc(l.ct)} ${l.n}</a>` : ''}</span><span class="mono small ac">${Math.floor(e.minutes / 60) ? Math.floor(e.minutes / 60) + ' h ' : ''}${e.minutes % 60} min</span></li>`;
    }).join('') : '<li class="emptyrow muted">No sessions yet. Log one, or finish a focus timer.</li>';
  }

  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const got = t.closest<HTMLElement>('[data-got]');
    const again = t.closest<HTMLElement>('[data-again]');
    if (got) {
      const [course, lesson, step] = got.dataset.got!.split('|');
      const s = Math.min(Number(step) + 1, REVIEW_STEPS.length - 1);
      got.setAttribute('disabled', '');
      await supa.from('lesson_progress').update({ review_step: s, next_review_at: addDays(REVIEW_STEPS[s]), updated_at: new Date().toISOString() }).eq('course', course).eq('lesson', lesson);
      refresh();
    } else if (again) {
      const [course, lesson] = again.dataset.again!.split('|');
      again.setAttribute('disabled', '');
      await supa.from('lesson_progress').update({ review_step: 0, next_review_at: addDays(1), updated_at: new Date().toISOString() }).eq('course', course).eq('lesson', lesson);
      refresh();
    }
  });

  $('log-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const minutes = Number(($('lf-min') as HTMLInputElement).value);
    if (!minutes) { $('lf-status').textContent = 'Enter the minutes you studied.'; return; }
    const note = ($('lf-note') as HTMLTextAreaElement).value.trim();
    const { error } = await supa.from('journal_entries').insert({ minutes, note: note || null });
    $('lf-status').textContent = error ? "Couldn't log that session. Try again." : `Logged ${minutes} min`;
    if (!error) { ($('lf-note') as HTMLTextAreaElement).value = ''; refresh(); }
  });

  // Focus timer
  const FULL = 25 * 60;
  let left = FULL, tick = 0;
  const arc = $('t-arc') as unknown as SVGCircleElement;
  const paint = () => {
    $('t-num').textContent = `${String(Math.floor(left / 60)).padStart(2, '0')}:${String(left % 60).padStart(2, '0')}`;
    arc.setAttribute('stroke-dashoffset', String(465 * (1 - left / FULL)));
  };
  $('t-start').addEventListener('click', () => {
    if (tick) { clearInterval(tick); tick = 0; $('t-start').textContent = 'Resume'; return; }
    $('t-start').textContent = 'Pause';
    tick = window.setInterval(async () => {
      left--; paint();
      if (left <= 0) {
        clearInterval(tick); tick = 0; left = FULL; paint(); $('t-start').textContent = 'Start';
        await supa.from('journal_entries').insert({ minutes: 25, note: 'Focus session' });
        refresh();
      }
    }, 1000);
  });
  $('t-reset').addEventListener('click', () => { clearInterval(tick); tick = 0; left = FULL; paint(); $('t-start').textContent = 'Start'; });

  // Supabase emits SIGNED_IN on every load once a session exists, so boot once instead of reloading.
  // Supabase calls are deferred out of the callback to avoid its auth lock deadlock.
  let booted = false;
  supa.auth.onAuthStateChange((ev) => {
    if (ev === 'SIGNED_OUT') { location.reload(); return; }
    if (!booted && (ev === 'INITIAL_SESSION' || ev === 'SIGNED_IN')) {
      booted = true;
      setTimeout(boot, 0);
    }
  });
</script>

<style>
  .page { padding-block: 32px 40px; }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 24px; }
  .lock { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 5px 10px; background: var(--surface); }
  .center { min-height: 50vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; text-align: center; }
  .center h1 { font-size: 40px; letter-spacing: -0.04em; }
  .small { font-size: 13px; }
  .hello { margin-bottom: 24px; }
  .hello h1 { font-size: clamp(34px, 5vw, 44px); letter-spacing: -0.04em; margin-top: 6px; }
  .hello .mono { font-size: 12px; }
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .stat { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 18px 20px; display: flex; flex-direction: column; gap: 4px; font-size: 13px; }
  .stat b { font-size: 34px; font-weight: 600; letter-spacing: -0.04em; line-height: 1.1; }
  .stat small { font-size: 16px; color: var(--muted); font-weight: 500; }
  #s-due-sub { color: var(--amber); }
  .stat.ink { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }
  .stat.ink small { color: inherit; opacity: .6; }
  .meter { height: 5px; border-radius: 5px; background: color-mix(in srgb, currentColor 18%, transparent); margin-top: 8px; }
  .meter i { display: block; height: 5px; border-radius: 5px; background: var(--sage); }
  .meter.soft { background: var(--line-soft); }
  .two { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 16px; margin-top: 16px; }
  .box { padding: 20px 22px; }
  .box h2 { font-size: 18px; letter-spacing: -0.02em; }
  .bh { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .rows { list-style: none; margin: 10px 0 0; padding: 0; }
  :global(.rrow) { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 0; border-top: 1px solid var(--line-soft); }
  :global(.rrow > div:first-child) { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  :global(.rrow a) { font-weight: 500; }
  :global(.ra) { display: flex; gap: 6px; flex: none; }
  :global(.emptyrow) { padding: 14px 0; border-top: 1px solid var(--line-soft); font-size: 14px; }
  :global(.emptyrow a) { color: var(--accent); }
  .timer { background: var(--sage-soft); border-radius: 18px; display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
  .timer .eyebrow { align-self: flex-start; }
  .ac { color: var(--sage); }
  .t-track { stroke: color-mix(in srgb, var(--sage) 22%, transparent); }
  .t-arc { stroke: var(--sage); transition: stroke-dashoffset 1s linear; }
  .t-num { font-family: var(--f-sans); font-weight: 600; font-size: 34px; fill: var(--fg); }
  .trow { display: flex; gap: 8px; }
  .heat { display: grid; grid-template-rows: repeat(7, 12px); grid-auto-flow: column; grid-auto-columns: 12px; gap: 4px; margin-top: 16px; overflow-x: auto; padding-bottom: 4px; }
  :global(.heat i) { width: 12px; height: 12px; border-radius: 3px; display: block; }
  :global(.heat .l0), .legend .l0 { background: var(--line-soft); }
  :global(.heat .l1), .legend .l1 { background: color-mix(in srgb, var(--sage) 35%, var(--line-soft)); }
  :global(.heat .l2), .legend .l2 { background: color-mix(in srgb, var(--sage) 65%, var(--line-soft)); }
  :global(.heat .l3), .legend .l3 { background: var(--sage); }
  :global(.heat .future) { background: transparent; }
  .legend { display: flex; justify-content: flex-end; align-items: center; gap: 5px; margin-top: 10px; }
  .legend i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
  .paths { display: flex; flex-direction: column; gap: 14px; margin-top: 14px; }
  :global(.pt) { display: flex; justify-content: space-between; gap: 8px; font-size: 14px; }
  :global(.meter.soft) { margin-top: 6px; }
  .weak { border-top: 1px solid var(--line-soft); margin-top: 18px; padding-top: 14px; display: flex; flex-direction: column; gap: 10px; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; }
  :global(.wchip) { font-size: 12px; background: var(--coral-soft); color: var(--coral); border-radius: 999px; padding: 5px 10px; }
  .logf { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; align-items: flex-start; }
  .logf label { font-size: 13px; color: var(--muted); }
  .logf input, .logf textarea { width: 100%; border: 1px solid var(--line); border-radius: 10px; padding: 9px 10px; background: var(--bg); font-size: 14px; }
  .logf input { width: 110px; font-family: var(--f-mono); }
  :global(.jrow) { display: grid; grid-template-columns: 70px minmax(0, 1fr) auto; gap: 14px; padding: 12px 0; border-top: 1px solid var(--line-soft); align-items: baseline; }
  :global(.jnote) { font-family: var(--f-serif); font-size: 16.5px; line-height: 1.5; }
