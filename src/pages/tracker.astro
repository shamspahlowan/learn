---
import Base from '../layouts/Base.astro';
import { allCourses, lessonsOf, PATHS } from '../lib/courses';

const courses = await allCourses();
const catalog = {
  lessons: courses.flatMap((c) => lessonsOf(c).map((l) => ({ c: c.slug, s: l.slug, t: l.title, n: l.number }))),
  courses: courses.map((c) => ({ slug: c.slug, title: c.title, cat: c.category, total: lessonsOf(c).length })),
  paths: PATHS.map((p) => ({ slug: p.slug, title: p.title, courses: p.courses })),
};
---
<Base title="Tracker" noindex>
  <script type="application/json" id="catalog" set:html={JSON.stringify(catalog)} />
  <div class="wrap page">
    <div class="bar">
      <span class="lock"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>Private · only you can see this</span>
      <button class="btn small" id="sign-out" type="button" hidden>Sign out</button>
    </div>

    <section id="v-loading" class="center"><span class="spinner" aria-hidden="true"></span><p class="muted">Loading your tracker…</p></section>

    <section id="v-signin" class="center" hidden>
      <span class="eyebrow">Private</span>
      <h1>Tracker</h1>
      <p class="muted">Sign in with GitHub to see your progress, reviews and journal.</p>
      <button class="btn primary" id="sign-in" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z"></path></svg>
        Sign in with GitHub
      </button>
      <p class="muted small" id="signin-error" role="alert"></p>
    </section>

    <section id="v-denied" class="center" hidden>
      <h1>This tracker is private</h1>
      <p class="muted">It belongs to the site's owner. Your account can't see or change anything here.</p>
    </section>

    <section id="v-dash" hidden>
      <header class="hello">
        <div>
          <span class="mono muted date" id="today-line"></span>
          <h1>Good <span id="part-of-day">day</span>, <span class="serif-em">Shams</span></h1>
          <p class="muted summary" id="summary"></p>
        </div>
        <div class="hello-actions">
          <button class="btn" type="button" id="open-log"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>Log session</button>
          <a class="btn primary" href="#focus"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2 2M9 2h6"></path></svg>Focus</a>
        </div>
      </header>

      <div class="grid">
        <article class="tile continue s7" id="continue"></article>
        <article class="tile reviews s5" id="reviews-card"></article>

        <div class="stats s12">
          <div class="stat"><span class="sl">This week</span><b id="st-week"></b><div class="mini" id="st-week-bars" aria-hidden="true"></div></div>
          <div class="stat"><span class="sl">Streak</span><b id="st-streak"></b><div class="dots" id="st-streak-dots" aria-hidden="true"></div><span class="sub" id="st-best"></span></div>
          <div class="stat ring-stat"><div><span class="sl">Lessons done</span><b id="st-done"></b><span class="sub" id="st-done-sub"></span></div><svg class="ring" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="26" class="rt"></circle><circle cx="32" cy="32" r="26" class="rv" id="st-done-ring" stroke-dasharray="0 164"></circle></svg></div>
          <div class="stat"><span class="sl">Avg confidence</span><b id="st-conf"></b><div class="confbar" id="st-conf-bar" aria-hidden="true"></div><span class="sub" id="st-weak"></span></div>
        </div>

        <section class="tile card s7" id="queue">
          <div class="th"><h2>Review queue</h2><span class="muted small" id="q-count"></span></div>
          <p class="hint small muted">Spaced repetition: each “Got it” pushes the next review further out (1 → 3 → 7 → 21 → 60 days). “Again” brings it back tomorrow.</p>
          <ol class="qlist" id="q-list"></ol>
        </section>

        <section class="tile timer s5" id="focus">
          <div class="th"><h2>Focus timer</h2><div class="presets" role="group" aria-label="Session length">
            <button type="button" data-preset="25" aria-pressed="true">25</button><button type="button" data-preset="45" aria-pressed="false">45</button><button type="button" data-preset="60" aria-pressed="false">60</button>
          </div></div>
          <div class="clock">
            <svg viewBox="0 0 200 200" role="img" aria-label="Focus timer">
              <circle cx="100" cy="100" r="86" class="ct"></circle>
              <circle cx="100" cy="100" r="86" class="cv" id="t-arc" stroke-dasharray="540.4 540.4" stroke-dashoffset="0" transform="rotate(-90 100 100)"></circle>
            </svg>
            <div class="clock-in"><span class="t-num mono" id="t-num">25:00</span><span class="small muted" id="t-on">Ready</span></div>
          </div>
          <div class="trow">
            <button class="btn primary" type="button" id="t-start">Start</button>
            <button class="btn" type="button" id="t-reset">Reset</button>
          </div>
          <p class="small muted center-t">Finished sessions log themselves to your journal.</p>
        </section>

        <section class="tile card s7">
          <div class="th"><h2>This week</h2>
            <label class="goal small muted">Goal <input id="goal" type="number" min="1" max="80" step="1" aria-label="Weekly goal in hours" /> h</label>
          </div>
          <div class="week" id="week-chart"></div>
          <div class="goalbar"><span class="small" id="goal-text"></span><span class="track"><i id="goal-fill"></i></span></div>
        </section>

        <section class="tile card s5">
          <div class="th"><h2>Paths</h2></div>
          <div class="paths" id="paths"></div>
        </section>

        <section class="tile card s12">
          <div class="th"><h2>Activity</h2><span class="mono muted small" id="heat-sum"></span></div>
          <div class="heat-wrap">
            <div class="wdays small muted" aria-hidden="true"><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span><span></span></div>
            <div class="heat-col">
              <div class="months small muted" id="months" aria-hidden="true"></div>
              <div class="heat" id="heat" role="img" aria-label="Study minutes per day over the last year"></div>
            </div>
          </div>
          <div class="legend small muted">Less <i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i> More</div>
        </section>

        <section class="tile card s7">
          <div class="th"><h2>Courses in progress</h2></div>
          <ol class="clist" id="courses"></ol>
        </section>

        <section class="tile card s5">
          <div class="th"><h2>Journal</h2></div>
          <ol class="journal" id="journal"></ol>
          <div class="weak-box">
            <span class="small muted">Weak spots · confidence 2 or below</span>
            <div class="chips" id="weak"></div>
          </div>
        </section>
      </div>
    </section>
  </div>

  <dialog class="logd" id="log-dialog" aria-labelledby="log-title">
    <form method="dialog" id="log-form" class="logf">
      <div class="th"><h2 id="log-title">Log a session</h2><button class="x" value="cancel" aria-label="Close">×</button></div>
      <span class="small muted">How long?</span>
      <div class="mins" role="group" aria-label="Minutes">
        {[15, 30, 45, 60, 90, 120].map((m) => <button type="button" data-min={m} aria-pressed={m === 45 ? 'true' : 'false'}>{m < 60 ? `${m}m` : `${m / 60}h`}</button>)}
      </div>
      <label for="lf-course" class="small muted">Course (optional)</label>
      <select id="lf-course"><option value="">General study</option>{courses.map((c) => <option value={c.slug}>{c.title}</option>)}</select>
      <label for="lf-note" class="small muted">What did you do?</label>
      <textarea id="lf-note" rows="3" placeholder="Finished the SVD lesson, did 2 NeetCode graph problems"></textarea>
      <div class="frow"><span class="small muted" id="lf-status" aria-live="polite"></span><button class="btn primary" type="submit" value="save">Save session</button></div>
    </form>
  </dialog>
</Base>

<script>
  import { supa, REVIEW_STEPS, addDays, isoDay } from '../scripts/supa';
  import { DEMO, isOwner, listProgress, listJournal, saveProgress, addJournal, fmtMinutes, esc, type Progress, type Journal } from '../scripts/store';

  type L = { c: string; s: string; t: string; n: string };
  type C = { slug: string; title: string; cat: string; total: number };
  const catalog = JSON.parse(document.getElementById('catalog')!.textContent!) as { lessons: L[]; courses: C[]; paths: { slug: string; title: string; courses: string[] }[] };
  const lessonBy = new Map(catalog.lessons.map((l) => [`${l.c}/${l.s}`, l]));
  const courseBy = new Map(catalog.courses.map((c) => [c.slug, c]));
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const link = (c: string, s?: string) => (s ? `${base}/courses/${c}/${s}/` : `${base}/courses/${c}/`);
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const show = (id: string) => ['v-loading', 'v-signin', 'v-denied', 'v-dash'].forEach((v) => ($(v).hidden = v !== id));
  const day = (iso: string, o: Intl.DateTimeFormatOptions) => new Date(`${iso}T00:00:00`).toLocaleDateString('en-GB', o);
  const hours = (m: number) => (Math.round((m / 60) * 10) / 10).toString();

  let PROG: Progress[] = [];
  let JR: Journal[] = [];

  $('sign-in').addEventListener('click', async () => {
    const { error } = await supa.auth.signInWithOAuth({ provider: 'github', options: { redirectTo: location.origin + location.pathname } });
    if (error) $('signin-error').textContent = `Sign-in failed: ${error.message}`;
  });
  $('sign-out').addEventListener('click', () => { supa.auth.signOut(); });

  async function boot() {
    if (location.hash === '#' || location.hash.includes('access_token')) history.replaceState(null, '', location.pathname + location.search);
    if (!DEMO) {
      const { data } = await supa.auth.getSession();
      if (!data.session) { show('v-signin'); return; }
      $('sign-out').hidden = false;
    }
    if (!(await isOwner())) { show('v-denied'); return; }
    show('v-dash');
    await refresh();
  }

  async function refresh() {
    [PROG, JR] = await Promise.all([listProgress(), listJournal()]);
    render();
  }

  function render() {
    const now = new Date();
    const today = isoDay();
    const h = now.getHours();
    $('part-of-day').textContent = h < 12 ? 'morning' : h < 17 ? 'afternoon' : 'evening';
    $('today-line').textContent = now.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' });

    const minutesBy = new Map<string, number>();
    JR.forEach((e) => minutesBy.set(e.day, (minutesBy.get(e.day) ?? 0) + e.minutes));
    const monday = new Date(now); monday.setDate(now.getDate() - ((now.getDay() + 6) % 7));
    const weekDays = Array.from({ length: 7 }, (_, i) => { const d = new Date(monday); d.setDate(monday.getDate() + i); return isoDay(d); });
    const weekMin = weekDays.reduce((s, d) => s + (minutesBy.get(d) ?? 0), 0);

    let streak = 0; const sd = new Date(now);
    if (!minutesBy.get(isoDay(sd))) sd.setDate(sd.getDate() - 1);
    while (minutesBy.get(isoDay(sd))) { streak++; sd.setDate(sd.getDate() - 1); }
    let best = 0, run = 0;
    for (let i = 7 * 52; i >= 0; i--) { if (minutesBy.get(addDays(-i))) { run++; best = Math.max(best, run); } else run = 0; }

    const done = PROG.filter((p) => p.status === 'done');
    const learning = PROG.filter((p) => p.status === 'learning');
    const due = done.filter((p) => p.next_review_at && p.next_review_at <= today).sort((a, b) => a.next_review_at!.localeCompare(b.next_review_at!));
    const doneSet = new Set(done.map((p) => `${p.course}/${p.lesson}`));

    $('summary').textContent = weekMin || streak || due.length
      ? `${hours(weekMin)} h this week · ${streak}-day streak · ${due.length ? `${due.length} review${due.length > 1 ? 's' : ''} waiting` : 'no reviews due'}`
      : 'A fresh start. Pick a lesson, mark it as learning, and log your first session.';

    // Continue card
    const cont = learning[0] ?? null;
    const target = cont ? lessonBy.get(`${cont.course}/${cont.lesson}`) : (() => {
      for (const p of catalog.paths[0].courses) { const l = catalog.lessons.find((x) => x.c === p && !doneSet.has(`${x.c}/${x.s}`)); if (l) return l; }
      return catalog.lessons[0];
    })();
    if (target) {
      const c = courseBy.get(target.c)!;
      const cDone = catalog.lessons.filter((l) => l.c === c.slug && doneSet.has(`${l.c}/${l.s}`)).length;
      $('continue').innerHTML = `
        <span class="eyebrow ac">${cont ? 'Pick up where you left off' : 'Start here'}</span>
        <h2 class="ct-title">${esc(target.t)}</h2>
        <span class="ct-sub">${esc(c.title)} · lesson ${target.n}</span>
        <div class="ct-prog"><span class="track"><i style="width:${(cDone / c.total) * 100}%"></i></span><span class="mono small">${cDone}/${c.total} in this course</span></div>
        <div class="ct-actions"><a class="btn light" href="${link(target.c, target.s)}">${cont ? 'Continue lesson' : 'Open lesson'} →</a>${cont ? `<button class="btn ghost" type="button" data-done="${target.c}|${target.s}">Mark done</button>` : ''}</div>`;
    }

    // Reviews card
    const next7 = Array.from({ length: 7 }, (_, i) => addDays(i));
    const counts = next7.map((d, i) => done.filter((p) => p.next_review_at && (i === 0 ? p.next_review_at <= d : p.next_review_at === d)).length);
    const maxC = Math.max(1, ...counts);
    $('reviews-card').innerHTML = `
      <span class="eyebrow">Reviews</span>
      <div class="rv-num"><b>${due.length}</b><span>${due.length === 1 ? 'lesson due' : 'lessons due'}</span></div>
      <div class="rv-week">${next7.map((d, i) => `<div class="rv-day${i === 0 ? ' today' : ''}" title="${counts[i]} due"><span class="rv-bar"><i style="height:${(counts[i] / maxC) * 100}%"></i></span><span class="mono">${i === 0 ? 'Today' : day(d, { weekday: 'narrow' })}</span></div>`).join('')}</div>
      ${due.length ? `<a class="btn small amber" href="#queue">Start reviewing ↓</a>` : `<span class="small rv-ok">All caught up</span>`}`;

    // Stats
    $('st-week').innerHTML = `${hours(weekMin)}<small> h</small>`;
    const maxDay = Math.max(30, ...weekDays.map((d) => minutesBy.get(d) ?? 0));
    $('st-week-bars').innerHTML = weekDays.map((d) => `<i class="${d === today ? 'now' : ''}${d > today ? ' future' : ''}" style="height:${Math.max(8, ((minutesBy.get(d) ?? 0) / maxDay) * 100)}%"></i>`).join('');
    $('st-streak').innerHTML = `${streak}<small> ${streak === 1 ? 'day' : 'days'}</small>`;
    $('st-streak-dots').innerHTML = Array.from({ length: 7 }, (_, i) => addDays(i - 6)).map((d) => `<i class="${minutesBy.get(d) ? 'on' : ''}" title="${day(d, { weekday: 'short' })}"></i>`).join('');
    $('st-best').textContent = `Best: ${best} days`;
    const total = catalog.lessons.length;
    $('st-done').innerHTML = `${done.length}<small> / ${total}</small>`;
    $('st-done-sub').textContent = `${learning.length} in progress`;
    $('st-done-ring').setAttribute('stroke-dasharray', `${Math.max(1.5, (done.length / total) * 163.4)} 164`);
    const rated = PROG.filter((p) => p.confidence);
    const avg = rated.length ? rated.reduce((s, p) => s + p.confidence!, 0) / rated.length : 0;
    $('st-conf').innerHTML = rated.length ? `${avg.toFixed(1)}<small> / 5</small>` : '–';
    $('st-conf-bar').innerHTML = [1, 2, 3, 4, 5].map((n) => `<i class="${n <= Math.round(avg) ? 'on' : ''}"></i>`).join('');
    const weak = PROG.filter((p) => p.confidence && p.confidence <= 2);
    $('st-weak').textContent = rated.length ? `${weak.length} weak spot${weak.length === 1 ? '' : 's'}` : 'Rate lessons as you go';

    // Review queue
    $('q-count').textContent = due.length ? `${due.length} due` : '';
    $('q-list').innerHTML = due.length ? due.map((p) => {
      const l = lessonBy.get(`${p.course}/${p.lesson}`);
      const c = courseBy.get(p.course);
      const late = p.next_review_at! < today ? Math.round((+new Date(today) - +new Date(p.next_review_at!)) / 864e5) : 0;
      return `<li class="qcard cat-${c?.cat ?? 'math'}">
        <div class="q-main">
          <span class="q-course">${esc(c?.title ?? p.course)} · ${l?.n ?? ''}</span>
          <a class="q-title" href="${link(p.course, p.lesson)}">${esc(l?.t ?? p.lesson)}</a>
          <span class="ladder" aria-label="Review ${p.review_step + 1} of ${REVIEW_STEPS.length}">${REVIEW_STEPS.map((s, i) => `<i class="${i < p.review_step ? 'past' : i === p.review_step ? 'cur' : ''}">${s}d</i>`).join('')}</span>
          ${late ? `<span class="late">${late} day${late > 1 ? 's' : ''} late</span>` : ''}
        </div>
        <div class="q-act"><button class="btn small" type="button" data-again="${p.course}|${p.lesson}">Again</button><button class="btn small primary" type="button" data-got="${p.course}|${p.lesson}|${p.review_step}">Got it</button></div>
      </li>`;
    }).join('') : `<li class="empty"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg><span>Nothing to review right now.</span><span class="small muted">Finish a lesson and it comes back here tomorrow, then after 3, 7, 21 and 60 days.</span></li>`;

    // Week chart
    const goal = Number(localStorage.getItem('weeklyGoalHours') || 10);
    ($('goal') as HTMLInputElement).value = String(goal);
    const maxW = Math.max(60, ...weekDays.map((d) => minutesBy.get(d) ?? 0));
    $('week-chart').innerHTML = weekDays.map((d) => {
      const m = minutesBy.get(d) ?? 0;
      return `<div class="wd${d === today ? ' today' : ''}${d > today ? ' future' : ''}"><span class="wv mono">${m ? fmtMinutes(m).replace(' min', 'm').replace(' h', 'h') : ''}</span><span class="wb"><i style="height:${(m / maxW) * 100}%"></i></span><span class="wl">${day(d, { weekday: 'short' })}</span></div>`;
    }).join('');
    const pct = Math.min(100, (weekMin / 60 / goal) * 100);
    $('goal-text').innerHTML = `<b>${hours(weekMin)} h</b> of ${goal} h goal${pct >= 100 ? ' · goal reached' : ''}`;
    $('goal-fill').style.width = `${pct}%`;

    // Paths
    $('paths').innerHTML = catalog.paths.map((p) => {
      const ls = catalog.lessons.filter((l) => p.courses.includes(l.c));
      const n = ls.filter((l) => doneSet.has(`${l.c}/${l.s}`)).length;
      const r = ls.length ? n / ls.length : 0;
      return `<a class="path" href="${base}/paths/#${p.slug}"><svg viewBox="0 0 44 44" aria-hidden="true"><circle cx="22" cy="22" r="18" class="rt"></circle><circle cx="22" cy="22" r="18" class="rv" stroke-dasharray="${Math.max(1, r * 113.1)} 114"></circle></svg><span class="pinfo"><span class="ptitle">${esc(p.title)}</span><span class="small muted">${n} of ${ls.length} lessons · ${Math.round(r * 100)}%</span></span></a>`;
    }).join('');

    // Heatmap
    const start = new Date(monday); start.setDate(start.getDate() - 7 * 51);
    let cells = '', tot = 0, active = 0, months = '', lastM = -1;
    for (let w = 0; w < 52; w++) {
      const d0 = new Date(start); d0.setDate(start.getDate() + w * 7);
      months += `<span>${d0.getMonth() !== lastM ? d0.toLocaleDateString('en-GB', { month: 'short' }) : ''}</span>`;
      lastM = d0.getMonth();
    }
    for (let i = 0; i < 52 * 7; i++) {
      const d = new Date(start); d.setDate(start.getDate() + i);
      const key = isoDay(d);
      const m = minutesBy.get(key) ?? 0; tot += m; if (m) active++;
      const lvl = key > today ? 'future' : m === 0 ? 'l0' : m < 45 ? 'l1' : m < 120 ? 'l2' : 'l3';
      cells += `<i class="${lvl}${key === today ? ' today' : ''}" title="${day(key, { day: 'numeric', month: 'short' })}: ${m ? fmtMinutes(m) : 'no study'}"></i>`;
    }
    $('months').innerHTML = months;
    $('heat').innerHTML = cells;
    $('heat-sum').textContent = `${Math.round(tot / 60)} h over ${active} days`;

    // Courses in progress
    const touched = [...new Set(PROG.map((p) => p.course))].map((s) => courseBy.get(s)).filter(Boolean) as C[];
    $('courses').innerHTML = touched.length ? touched.map((c) => {
      const d = catalog.lessons.filter((l) => l.c === c.slug && doneSet.has(`${l.c}/${l.s}`)).length;
      const lr = learning.filter((p) => p.course === c.slug).length;
      return `<li><a class="crow cat-${c.cat}" href="${link(c.slug)}"><span class="cdot"></span><span class="cinfo"><span class="ctitle">${esc(c.title)}</span><span class="small muted">${d}/${c.total} done${lr ? ` · ${lr} learning` : ''}</span></span><span class="track"><i style="width:${(d / c.total) * 100}%"></i></span><span class="mono small muted">${Math.round((d / c.total) * 100)}%</span></a></li>`;
    }).join('') : `<li class="empty"><span>No courses started yet.</span><a class="small link" href="${base}/courses/">Browse courses →</a></li>`;

    // Journal
    $('journal').innerHTML = JR.length ? JR.slice(0, 8).map((e) => {
      const l = e.course && e.lesson ? lessonBy.get(`${e.course}/${e.lesson}`) : null;
      const c = e.course ? courseBy.get(e.course) : null;
      const title = e.note || (l ? l.t : c ? c.title : 'Study session');
      return `<li class="jrow"><span class="jdot"></span><div class="jbody"><span class="jmeta mono">${day(e.day, { day: 'numeric', month: 'short' })} · ${fmtMinutes(e.minutes)}</span><span class="jnote">${esc(title)}</span>${c ? `<a class="small link" href="${link(c.slug, l?.s)}">${esc(c.title)}${l ? ` ${l.n}` : ''}</a>` : ''}</div></li>`;
    }).join('') : `<li class="empty"><span>No sessions yet.</span><span class="small muted">Log one, or finish a focus timer.</span></li>`;

    $('weak').innerHTML = weak.length ? weak.map((p) => `<a class="wchip" href="${link(p.course, p.lesson)}">${esc(lessonBy.get(`${p.course}/${p.lesson}`)?.t ?? p.lesson)}</a>`).join('') : '<span class="small muted">None yet. Rate your confidence on each lesson page.</span>';
  }

  // Actions
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const got = t.closest<HTMLButtonElement>('[data-got]');
    const again = t.closest<HTMLButtonElement>('[data-again]');
    const markDone = t.closest<HTMLButtonElement>('[data-done]');
    if (got) {
      const [course, lesson, step] = got.dataset.got!.split('|');
      const s = Math.min(Number(step) + 1, REVIEW_STEPS.length - 1);
      got.closest('li')?.classList.add('leaving');
      await saveProgress({ course, lesson, review_step: s, next_review_at: addDays(REVIEW_STEPS[s]) });
      await refresh();
    } else if (again) {
      const [course, lesson] = again.dataset.again!.split('|');
      again.closest('li')?.classList.add('leaving');
      await saveProgress({ course, lesson, review_step: 0, next_review_at: addDays(1) });
      await refresh();
    } else if (markDone) {
      const [course, lesson] = markDone.dataset.done!.split('|');
      await saveProgress({ course, lesson, status: 'done', completed_at: new Date().toISOString(), review_step: 0, next_review_at: addDays(REVIEW_STEPS[0]) });
      await refresh();
    }
  });

  $('goal').addEventListener('change', () => {
    const v = Math.max(1, Math.min(80, Number(($('goal') as HTMLInputElement).value) || 10));
    try { localStorage.setItem('weeklyGoalHours', String(v)); } catch {}
    render();
  });

  // Log dialog
  const dlg = $('log-dialog') as HTMLDialogElement;
  let logMin = 45;
  $('open-log').addEventListener('click', () => { $('lf-status').textContent = ''; dlg.showModal(); });
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.querySelectorAll<HTMLButtonElement>('[data-min]').forEach((b) => b.addEventListener('click', () => {
    logMin = Number(b.dataset.min);
    dlg.querySelectorAll('[data-min]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  }));
  $('log-form').addEventListener('submit', async (e) => {
    if ((e as SubmitEvent).submitter?.getAttribute('value') !== 'save') return;
    e.preventDefault();
    const note = ($('lf-note') as HTMLTextAreaElement).value.trim();
    const course = ($('lf-course') as HTMLSelectElement).value || null;
    try {
      await addJournal({ minutes: logMin, note: note || null, course });
      ($('lf-note') as HTMLTextAreaElement).value = '';
      dlg.close();
      await refresh();
    } catch { $('lf-status').textContent = "Couldn't save. Check your connection."; }
  });

  // Focus timer
  let full = 25 * 60, left = full, tick = 0;
  const C = 540.4;
  const arc = $('t-arc') as unknown as SVGCircleElement;
  const paint = () => {
    $('t-num').textContent = `${String(Math.floor(left / 60)).padStart(2, '0')}:${String(left % 60).padStart(2, '0')}`;
    arc.setAttribute('stroke-dashoffset', String(C * (1 - left / full)));
  };
  const setRunning = (on: boolean) => { $('focus').classList.toggle('running', on); $('t-on').textContent = on ? 'Focusing…' : left < full ? 'Paused' : 'Ready'; };
  document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
    if (tick) return;
    full = left = Number(b.dataset.preset) * 60;
    document.querySelectorAll('[data-preset]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    paint(); setRunning(false);
  }));
  $('t-start').addEventListener('click', () => {
    if (tick) { clearInterval(tick); tick = 0; $('t-start').textContent = 'Resume'; setRunning(false); return; }
    $('t-start').textContent = 'Pause'; setRunning(true);
    tick = window.setInterval(async () => {
      left--; paint();
      if (left <= 0) {
        clearInterval(tick); tick = 0;
        const mins = full / 60;
        left = full; paint(); $('t-start').textContent = 'Start'; setRunning(false);
        $('t-on').textContent = `Logged ${mins} min`;
        await addJournal({ minutes: mins, note: 'Focus session' });
        await refresh();
      }
    }, 1000);
  });
  $('t-reset').addEventListener('click', () => { clearInterval(tick); tick = 0; left = full; paint(); $('t-start').textContent = 'Start'; setRunning(false); });

  // Supabase emits SIGNED_IN on every load once a session exists, so boot once instead of reloading.
  // Supabase calls are deferred out of the callback to avoid its auth lock deadlock.
  if (DEMO) boot();
  else {
    let booted = false;
    supa.auth.onAuthStateChange((ev) => {
      if (ev === 'SIGNED_OUT') { location.reload(); return; }
      if (!booted && (ev === 'INITIAL_SESSION' || ev === 'SIGNED_IN')) { booted = true; setTimeout(boot, 0); }
    });
  }
</script>

