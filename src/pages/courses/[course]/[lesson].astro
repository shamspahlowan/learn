---
import 'katex/dist/katex.min.css';
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ResourceList from '../../../components/ResourceList.astro';
import { allCourses, lessonsOf, type Course, type LessonRef } from '../../../lib/courses';
import { url } from '../../../lib/site';

export async function getStaticPaths() {
  const courses = await allCourses();
  const notes = await getCollection('notes');
  return courses.flatMap((course) => {
    const lessons = lessonsOf(course);
    return lessons.map((lesson, i) => ({
      params: { course: course.slug, lesson: lesson.slug },
      props: {
        course,
        lesson,
        lessons,
        prev: lessons[i - 1] ?? null,
        next: lessons[i + 1] ?? null,
        note: notes.find((n) => n.id === `${course.slug}/${lesson.slug}`) ?? null,
      },
    }));
  });
}

interface Props {
  course: Course;
  lesson: LessonRef;
  lessons: LessonRef[];
  prev: LessonRef | null;
  next: LessonRef | null;
  note: Awaited<ReturnType<typeof getCollection<'notes'>>>[number] | null;
}
const { course, lesson, lessons, prev, next, note } = Astro.props;
const mod = course.modules[lesson.moduleIndex];
const siblings = lessons.filter((l) => l.moduleIndex === lesson.moduleIndex);
const rendered = note ? await render(note) : null;
const Content = rendered?.Content;
const headings = rendered?.headings.filter((h) => h.depth <= 3) ?? [];
const selfCheck = note?.data.selfCheck ?? [];
const updated = note?.data.updated;
const depthText = { core: 'core: you must be able to do this', interview: 'interview: you must be able to explain or derive this', research: 'research: proofs, papers and open questions' }[lesson.depth];
const prompt = `Act as a senior ML engineer interviewing me. Topic: "${lesson.title}" (${course.title}, module "${mod.title}"). Ask me one ${lesson.depth === 'research' ? 'deep, research-level' : 'interview-level'} question at a time. After each answer, score it out of 10, say what was missing, show a stronger answer, then ask a follow-up.`;
---
<Base title={`${lesson.title} · ${course.title}`} description={`Lesson ${lesson.number} of ${course.title}: ${lesson.title}.`}>
  <div class="progress" aria-hidden="true"><i id="read-bar"></i></div>
  <div class="wrap cols">
    <aside class="outline" aria-label="Lessons in this module">
      <a class="eyebrow back" href={url(`/courses/${course.slug}/`)}>← {course.title}</a>
      <span class="eyebrow mtitle">Module {lesson.moduleIndex + 1} · {mod.title}</span>
      <ol>
        {siblings.map((s) => (
          <li><a href={url(`/courses/${course.slug}/${s.slug}/`)} aria-current={s.slug === lesson.slug ? 'page' : undefined} data-lesson={s.slug}><span class="mono">{s.number}</span>{s.title}</a></li>
        ))}
      </ol>
    </aside>

    <article class="main" data-pagefind-body>
      <span class="mono meta">Lesson {lesson.number}{updated ? ` · updated ${updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}` : ''}</span>
      <h1>{lesson.title}</h1>
      <div class="chips" data-pagefind-ignore>
        <span class={`chip d-${lesson.depth}`} title={depthText}>{lesson.depth}</span>
        {lesson.anim && <span class="chip anim">animation planned</span>}
      </div>

      {note?.data.why && (
        <div class="why"><span class="eyebrow ac">Why it matters in ML</span><p>{note.data.why}</p></div>
      )}

      {Content ? (
        <div class="prose"><Content /></div>
      ) : (
        <div class="empty" data-pagefind-ignore>
          <p class="et">Notes for this lesson aren't written yet.</p>
          <p class="muted">Study it from the resources below, then write your notes in <code>content/notes/{course.slug}/{lesson.slug}.md</code>. They'll appear here on the next deploy.</p>
        </div>
      )}

      {(mod.resources.length > 0 || mod.practice.length > 0) && (
        <section class="learn">
          <h2 id="learn-it-from">Learn it from</h2>
          {mod.resources.length > 0 && <ResourceList items={mod.resources} />}
          {mod.practice.length > 0 && <><h3 class="eyebrow">Practice</h3><ResourceList items={mod.practice} practice /></>}
        </section>
      )}

      <section class="check" data-pagefind-ignore>
        <div class="check-top"><span class="eyebrow ac">Self-check</span><span class="muted small">Answer out loud before you mark this lesson done.</span></div>
        {selfCheck.length > 0 ? (
          <ol class="qs">{selfCheck.map((q) => <li>{q}</li>)}</ol>
        ) : (
          <p class="q">Could you explain “{lesson.title}” to a friend in two minutes, with an example from your own work?</p>
        )}
        <button class="btn small" type="button" id="copy-prompt" data-prompt={prompt}>Copy as a Claude mock interview</button>
        <span class="muted small" id="copy-status" aria-live="polite"></span>
      </section>

      <nav class="pn" aria-label="Lesson navigation">
        {prev ? <a href={url(`/courses/${course.slug}/${prev.slug}/`)}><span class="muted small">← Previous</span><span>{prev.title}</span></a> : <span></span>}
        {next ? <a class="r" href={url(`/courses/${course.slug}/${next.slug}/`)}><span class="muted small">Next →</span><span>{next.title}</span></a> : <a class="r" href={url(`/courses/${course.slug}/`)}><span class="muted small">Done →</span><span>Back to the course</span></a>}
      </nav>
    </article>

    <aside class="side">
      {headings.length > 0 && (
        <div>
          <span class="eyebrow">On this page</span>
          <ul class="toc">{headings.map((h) => <li class={`h${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </div>
      )}

      <div class="owner card" id="owner-panel" hidden data-course={course.slug} data-lesson={lesson.slug}>
        <div class="o-head"><span class="eyebrow">Your progress</span><span class="lock mono">private</span></div>
        <div class="seg" role="group" aria-label="Lesson status">
          <button type="button" data-status="none">Not started</button>
          <button type="button" data-status="learning">Learning</button>
          <button type="button" data-status="done">Done</button>
        </div>
        <div class="conf">
          <span class="small muted">Confidence</span>
          <div class="stars" role="group" aria-label="Confidence from 1 to 5">
            {[1, 2, 3, 4, 5].map((n) => <button type="button" data-conf={n} aria-label={`Confidence ${n}`}>{n}</button>)}
          </div>
        </div>
        <p class="small muted" id="review-line"></p>
        <label for="private-note" class="small muted">Private notes (only you can see these)</label>
        <textarea id="private-note" rows="5" placeholder="What clicked, what's still fuzzy, what to ask a senior"></textarea>
        <div class="log">
          <label for="log-min" class="small muted">Log minutes</label>
          <input id="log-min" type="number" min="5" max="600" step="5" value="30" />
          <button type="button" class="btn small" id="log-btn">Log</button>
        </div>
        <span class="small muted" id="owner-status" aria-live="polite"></span>
      </div>
    </aside>
  </div>
</Base>

<script>
  const bar = document.getElementById('read-bar');
  const onScroll = () => {
    const h = document.documentElement;
    const p = h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight);
    if (bar) bar.style.width = `${Math.min(100, p * 100)}%`;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const copyBtn = document.getElementById('copy-prompt');
  const copyStatus = document.getElementById('copy-status')!;
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.prompt ?? '');
      copyStatus.textContent = 'Copied. Paste it into a new chat on claude.ai.';
    } catch {
      copyStatus.textContent = 'Copy failed. Select the lesson title instead.';
    }
  });
</script>

<script>
  import { getOwner, mightBeSignedIn, supa, REVIEW_STEPS, addDays, isoDay } from '../../../scripts/supa';

  (async () => {
    if (!mightBeSignedIn()) return;
    const owner = await getOwner();
    if (!owner) return;
    const panel = document.getElementById('owner-panel')!;
    const course = panel.dataset.course!;
    const lesson = panel.dataset.lesson!;
    const say = (t: string) => { document.getElementById('owner-status')!.textContent = t; };
    const note = document.getElementById('private-note') as HTMLTextAreaElement;
    const reviewLine = document.getElementById('review-line')!;
    panel.hidden = false;

    let row: any = null;
    const [{ data: p }, { data: n }, { data: siblings }] = await Promise.all([
      supa.from('lesson_progress').select('*').eq('course', course).eq('lesson', lesson).maybeSingle(),
      supa.from('lesson_notes').select('body').eq('course', course).eq('lesson', lesson).maybeSingle(),
      supa.from('lesson_progress').select('lesson,status').eq('course', course),
    ]);
    row = p;
    note.value = n?.body ?? '';
    for (const s of siblings ?? []) {
      const a = document.querySelector<HTMLElement>(`.outline [data-lesson="${s.lesson}"]`);
      if (a) a.dataset.status = s.status;
    }

    function paint() {
      const status = row?.status ?? 'none';
      panel.querySelectorAll<HTMLButtonElement>('[data-status]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.status === status)));
      panel.querySelectorAll<HTMLButtonElement>('[data-conf]').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.conf) <= (row?.confidence ?? 0))));
      reviewLine.textContent = row?.status === 'done' && row?.next_review_at
        ? (row.next_review_at <= isoDay() ? 'Review due today.' : `Next review ${new Date(row.next_review_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}.`)
        : '';
    }
    paint();

    async function save(patch: Record<string, unknown>) {
      say('Saving…');
      if (patch.status === 'none') {
        await supa.from('lesson_progress').delete().eq('course', course).eq('lesson', lesson);
        row = null; paint(); say('Saved'); return;
      }
      const next = { ...(row ?? {}), course, lesson, ...patch, updated_at: new Date().toISOString() };
      delete (next as any).user_id;
      const { data, error } = await supa.from('lesson_progress').upsert(next, { onConflict: 'user_id,course,lesson' }).select().single();
      if (error) { say("Couldn't save. Check your connection and try again."); return; }
      row = data; paint(); say('Saved');
    }

    panel.querySelectorAll<HTMLButtonElement>('[data-status]').forEach((b) => b.addEventListener('click', () => {
      const s = b.dataset.status!;
      if (s === 'done') save({ status: 'done', completed_at: new Date().toISOString(), review_step: 0, next_review_at: addDays(REVIEW_STEPS[0]) });
      else if (s === 'learning') save({ status: 'learning', completed_at: null, next_review_at: null, review_step: 0 });
      else save({ status: 'none' });
    }));
    panel.querySelectorAll<HTMLButtonElement>('[data-conf]').forEach((b) => b.addEventListener('click', () => save({ status: row?.status ?? 'learning', confidence: Number(b.dataset.conf) })));

    let t = 0;
    note.addEventListener('input', () => {
      clearTimeout(t);
      t = window.setTimeout(async () => {
        say('Saving note…');
        const { error } = await supa.from('lesson_notes').upsert({ course, lesson, body: note.value, updated_at: new Date().toISOString() }, { onConflict: 'user_id,course,lesson' });
        say(error ? "Couldn't save the note." : 'Note saved');
      }, 800);
    });

    document.getElementById('log-btn')!.addEventListener('click', async () => {
      const minutes = Number((document.getElementById('log-min') as HTMLInputElement).value);
      if (!minutes || minutes < 1) { say('Enter the minutes you studied.'); return; }
      const { error } = await supa.from('journal_entries').insert({ minutes, course, lesson, note: document.querySelector('h1')?.textContent ?? '' });
      say(error ? "Couldn't log that session." : `Logged ${minutes} min`);
    });
  })();
</script>

<style>
  .progress { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 65px); z-index: 4; height: 2px; background: transparent; }
  .progress i { display: block; height: 2px; width: 0; background: var(--accent); }
  .cols { display: grid; grid-template-columns: 230px minmax(0, 1fr) 260px; gap: 48px; align-items: start; padding-block: 48px 40px; }
  .outline, .side { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 6px; max-height: calc(100vh - 120px); overflow-y: auto; }
  .back { margin-bottom: 14px; }
  .back:hover { color: var(--accent); }
  .mtitle { margin-bottom: 8px; }
  .outline ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .outline a { display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 4px; padding: 8px 10px; border-radius: 10px; font-size: 14px; color: var(--muted); line-height: 1.35; }
  .outline a .mono { font-size: 11.5px; padding-top: 2px; }
  .outline a[aria-current='page'] { background: var(--surface); color: var(--fg); box-shadow: inset 0 0 0 1px var(--line); }
  .outline a[aria-current='page'] .mono { color: var(--accent); }
  .outline a[data-status='done'] .mono { color: var(--sage); }
  .outline a[data-status='done'] .mono::after { content: ' ✓'; }
  .main { min-width: 0; max-width: 720px; }
  .meta { font-size: 12px; color: var(--muted); }
  h1 { font-size: clamp(34px, 4.6vw, 50px); line-height: 1.05; letter-spacing: -0.045em; margin: 10px 0 16px; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 30px; }
  .anim { background: var(--sunk); color: var(--muted); }
  .why { border: 1px solid var(--line); background: var(--surface); border-radius: 16px; padding: 18px 20px; margin-bottom: 32px; }
  .why p { margin-top: 8px; font-size: 16px; line-height: 1.6; }
  .ac { color: var(--accent); }
  .empty { border: 1px dashed var(--line); border-radius: 16px; padding: 22px; display: flex; flex-direction: column; gap: 8px; }
  .et { font-family: var(--f-serif); font-size: 21px; }
  .empty .muted { font-size: 14.5px; line-height: 1.6; }
  .empty code { font-family: var(--f-mono); font-size: 12px; background: var(--sunk); padding: 2px 6px; border-radius: 6px; }
  .learn { margin-top: 48px; }
  .learn h2 { font-size: 22px; margin-bottom: 8px; }
  .learn h3 { margin: 20px 0 4px; }
  .check { margin-top: 40px; border-radius: 18px; padding: 22px 24px; background: var(--sage-soft); display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .check-top { display: flex; justify-content: space-between; gap: 12px; width: 100%; flex-wrap: wrap; }
  .q, .qs { font-family: var(--f-serif); font-size: 21px; line-height: 1.45; }
  .qs { margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: 8px; }
  .small { font-size: 13px; }
  .pn { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; border-top: 1px solid var(--line); margin-top: 40px; padding-top: 22px; }
  .pn a { display: flex; flex-direction: column; gap: 4px; font-weight: 500; max-width: 48%; }
  .pn .r { text-align: right; margin-left: auto; }
  .toc { list-style: none; margin: 10px 0 0; padding: 0 0 0 14px; border-left: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; font-size: 14px; }
  .toc .h3 { padding-left: 12px; }
  .toc a { color: var(--muted); }
  .owner { margin-top: 20px; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
  .o-head { display: flex; justify-content: space-between; align-items: center; }
  .lock { font-size: 10.5px; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 2px 8px; }
  .seg { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  .seg button { border: 0; background: transparent; padding: 9px 4px; font-size: 12.5px; cursor: pointer; min-height: 40px; }
  .seg button + button { border-left: 1px solid var(--line); }
  .seg button[aria-pressed='true'] { background: var(--ink); color: var(--on-ink); }
  .conf { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .stars { display: flex; gap: 4px; }
  .stars button { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--line); background: var(--surface); font-family: var(--f-mono); font-size: 12px; cursor: pointer; }
  .stars button[aria-pressed='true'] { background: var(--sage-soft); color: var(--sage); border-color: var(--sage); }
  textarea { width: 100%; border: 1px solid var(--line); border-radius: 10px; padding: 10px; background: var(--bg); resize: vertical; font-size: 14px; line-height: 1.5; }
  .log { display: flex; align-items: center; gap: 8px; }
  .log input { width: 70px; border: 1px solid var(--line); border-radius: 8px; padding: 7px 8px; background: var(--bg); font-family: var(--f-mono); font-size: 13px; }
  @media (max-width: 1100px) {
    .cols { grid-template-columns: minmax(0, 1fr) 260px; }
    .outline { display: none; }
  }
  @media (max-width: 820px) {
    .cols { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .side { position: static; max-height: none; }
    .side > div:first-child:not(.owner) { display: none; }
    .progress { top: calc(env(safe-area-inset-top, 0px) + 65px); }
  }
</style>
