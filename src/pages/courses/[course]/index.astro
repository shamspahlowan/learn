---
import Base from '../../../layouts/Base.astro';
import Cover from '../../../components/Cover.astro';
import ResourceList from '../../../components/ResourceList.astro';
import { allCourses, CATEGORIES, lessonsOf, PATHS, type Course } from '../../../lib/courses';
import { url } from '../../../lib/site';

export async function getStaticPaths() {
  const courses = await allCourses();
  return courses.map((c) => ({ params: { course: c.slug }, props: { course: c, all: courses } }));
}
interface Props { course: Course; all: Course[] }
const { course, all } = Astro.props;
const lessons = lessonsOf(course);
const byModule = course.modules.map((m, i) => ({ ...m, refs: lessons.filter((l) => l.moduleIndex === i) }));
const prereqs = course.prereqs.map((p) => all.find((c) => c.slug === p)).filter(Boolean) as Course[];
const nextInPath = (() => {
  for (const p of PATHS) {
    const i = p.courses.indexOf(course.slug);
    if (i !== -1 && i < p.courses.length - 1) {
      const n = all.find((c) => c.slug === p.courses[i + 1]);
      if (n) return { path: p, course: n };
    }
  }
  return null;
})();
const counts = { core: 0, interview: 0, research: 0 };
lessons.forEach((l) => counts[l.depth]++);
const anims = lessons.filter((l) => l.anim).length;
---
<Base title={course.title} description={course.summary}>
  <div data-pagefind-body>
    <section class:list={['hdr-band', `cat-${course.category}`]}>
      <div class="wrap hdr">
        <div class="hdr-copy">
          <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore><a href={url('/courses/')}>Courses</a><span aria-hidden="true">/</span><span class="cat">{CATEGORIES[course.category]}</span></nav>
          <h1>{course.title}</h1>
          <p class="lede">{course.summary}</p>
          <dl class="nums">
            <div><dt>modules</dt><dd>{course.modules.length}</dd></div>
            <div><dt>lessons</dt><dd>{lessons.length}</dd></div>
            <div><dt>estimated</dt><dd>~{course.hours} h</dd></div>
            <div><dt>animations planned</dt><dd>{anims}</dd></div>
          </dl>
          <div class="depth" data-pagefind-ignore>
            <span class="bar" aria-hidden="true">
              <i class="d-core" style={`flex:${counts.core}`}></i><i class="d-interview" style={`flex:${counts.interview}`}></i><i class="d-research" style={`flex:${counts.research}`}></i>
            </span>
            <span class="legend"><span><b class="dot core"></b>{counts.core} core</span><span><b class="dot interview"></b>{counts.interview} interview</span><span><b class="dot research"></b>{counts.research} research</span></span>
          </div>
          <div class="cta">
            <a class="btn primary" href={url(`/courses/${course.slug}/${lessons[0].slug}/`)} id="cta-start">Start lesson 1.1 <span aria-hidden="true">→</span></a>
            <a class="btn" href="#syllabus">See the syllabus</a>
          </div>
          <div class="mine" id="mine" hidden data-pagefind-ignore>
            <span class="mine-top"><span class="eyebrow">Your progress</span><span class="mono" id="mine-num"></span></span>
            <span class="track"><i id="mine-bar"></i></span>
          </div>
        </div>
        <div class="cover-wrap"><Cover slug={course.slug} category={course.category} big /></div>
      </div>
    </section>

    <div class:list={['wrap', 'body', `cat-${course.category}`]}>
      <aside class="rail" aria-label="Course navigation">
        <nav class="card box mods-nav" data-pagefind-ignore>
          <span class="eyebrow">Modules</span>
          <ol>
            {byModule.map((m, mi) => (
              <li><a href={`#m${mi + 1}`} data-mod={mi}>
                <span class="mono n">{String(mi + 1).padStart(2, '0')}</span>
                <span class="t">{m.title}</span>
                <span class="mono c" data-mod-count={mi}>{m.refs.length}</span>
              </a></li>
            ))}
          </ol>
        </nav>

        {course.course_resources.length > 0 && (
          <section class="card box">
            <span class="eyebrow">Main resources</span>
            <ResourceList items={course.course_resources} compact />
          </section>
        )}

        {prereqs.length > 0 && (
          <section class="card box" data-pagefind-ignore>
            <span class="eyebrow">Take these first</span>
            <ul class="plain">{prereqs.map((p) => <li><a href={url(`/courses/${p.slug}/`)}>{p.title} →</a></li>)}</ul>
          </section>
        )}

        {nextInPath && (
          <a class="next" href={url(`/courses/${nextInPath.course.slug}/`)} data-pagefind-ignore>
            <span class="eyebrow ac">Next in {nextInPath.path.title}</span>
            <span class="ntitle">{nextInPath.course.title} <span aria-hidden="true">→</span></span>
          </a>
        )}
      </aside>

      <div class="main">
        {course.outcomes.length > 0 && (
          <section>
            <h2>By the end you can</h2>
            <ul class="outs">
              {course.outcomes.map((o) => (
                <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg>{o}</li>
              ))}
            </ul>
          </section>
        )}

        <section id="syllabus">
          <div class="syl-head">
            <h2>Syllabus</h2>
            <div class="syl-tools" data-pagefind-ignore>
              <button type="button" class="link-btn" id="expand-all">Expand all</button>
            </div>
          </div>
          {byModule.map((m, mi) => (
            <details class="mod card" open={mi === 0} id={`m${mi + 1}`}>
              <summary>
                <span class="mono mnum">{String(mi + 1).padStart(2, '0')}</span>
                <span class="mtitle">{m.title}<span class="mmeta">{m.refs.length} lessons{m.practice.length ? ` · ${m.practice.length} practice` : ''}{m.resources.length ? ` · ${m.resources.length} resources` : ''}</span></span>
                <span class="mprog mono" data-mod-prog={mi} hidden></span>
                <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
              </summary>
              <ol class="lessons">
                {m.refs.map((l) => (
                  <li>
                    <a href={url(`/courses/${course.slug}/${l.slug}/`)} class="lrow" data-lesson={l.slug} data-mod={mi}>
                      <span class="status" aria-hidden="true"></span>
                      <span class="mono lnum">{l.number}</span>
                      <span class="ltitle">{l.title}</span>
                      <span class="tags" data-pagefind-ignore>
                        {l.anim && <span class="anim" title="Animation planned"><svg width="10" height="10" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16l13-8z" fill="currentColor"></path></svg></span>}
                        <span class={`chip d-${l.depth}`}>{l.depth}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
              {(m.resources.length > 0 || m.practice.length > 0) && (
                <div class="mres">
                  {m.resources.length > 0 && <div><span class="eyebrow">Learn it from</span><ResourceList items={m.resources} /></div>}
                  {m.practice.length > 0 && <div><span class="eyebrow">Practice</span><ResourceList items={m.practice} practice /></div>}
                </div>
              )}
            </details>
          ))}
        </section>
      </div>
    </div>
  </div>
</Base>

<script>
  import { isOwner, listProgress } from '../../../scripts/store';
  import { isoDay } from '../../../scripts/supa';

  const all = document.querySelectorAll<HTMLDetailsElement>('details.mod');
  const btn = document.getElementById('expand-all')!;
  btn.addEventListener('click', () => {
    const open = [...all].some((d) => !d.open);
    all.forEach((d) => (d.open = open));
    btn.textContent = open ? 'Collapse all' : 'Expand all';
  });
  document.querySelectorAll<HTMLAnchorElement>('.mods-nav a').forEach((a) =>
    a.addEventListener('click', () => {
      const d = document.querySelector<HTMLDetailsElement>(a.getAttribute('href')!);
      if (d) d.open = true;
    }),
  );

  (async () => {
    if (!(await isOwner())) return;
    const course = location.pathname.split('/').filter(Boolean).at(-1)!;
    const rows = await listProgress(course);
    const today = isoDay();
    const status = new Map(rows.map((r) => [r.lesson, r.status === 'done' && r.next_review_at && r.next_review_at <= today ? 'review' : r.status]));
    const lessonEls = [...document.querySelectorAll<HTMLElement>('.lrow')];
    let done = 0;
    const perMod = new Map<string, { d: number; t: number }>();
    for (const el of lessonEls) {
      const s = status.get(el.dataset.lesson!);
      if (s) el.dataset.status = s;
      const m = perMod.get(el.dataset.mod!) ?? { d: 0, t: 0 };
      m.t++;
      if (s === 'done' || s === 'review') { m.d++; done++; }
      perMod.set(el.dataset.mod!, m);
    }
    perMod.forEach((v, k) => {
      const prog = document.querySelector<HTMLElement>(`[data-mod-prog="${k}"]`);
      if (prog && v.d) { prog.hidden = false; prog.textContent = `${v.d}/${v.t}`; prog.classList.toggle('full', v.d === v.t); }
      const c = document.querySelector<HTMLElement>(`[data-mod-count="${k}"]`);
      if (c) { c.textContent = `${v.d}/${v.t}`; c.classList.toggle('full', v.d === v.t); }
    });
    const mine = document.getElementById('mine')!;
    mine.hidden = false;
    document.getElementById('mine-num')!.textContent = `${done} of ${lessonEls.length} done`;
    document.getElementById('mine-bar')!.style.width = `${(done / lessonEls.length) * 100}%`;
    const next = lessonEls.find((el) => el.dataset.status !== 'done' && el.dataset.status !== 'review');
    const cta = document.getElementById('cta-start') as HTMLAnchorElement;
    if (next && done) {
      cta.href = (next as HTMLAnchorElement).href;
      cta.firstChild!.textContent = `Continue with ${next.querySelector('.lnum')!.textContent} `;
    }
  })();
</script>

<style>
  .hdr-band { background: var(--surface); border-bottom: 1px solid var(--line); }
  .hdr { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 56px; align-items: center; padding-block: 56px 52px; }
  .hdr-copy { display: flex; flex-direction: column; gap: 20px; }
  .crumbs { display: flex; gap: 8px; font-family: var(--f-mono); font-size: 12px; color: var(--muted); }
  .crumbs .cat { color: var(--c); }
  h1 { font-size: clamp(36px, 5vw, 54px); line-height: 1.04; letter-spacing: -0.045em; }
  .lede { font-size: 18px; line-height: 1.6; color: var(--muted); max-width: 34em; }
  .nums { display: flex; gap: 32px; flex-wrap: wrap; margin: 0; }
  .nums div { display: flex; flex-direction: column-reverse; }
  .nums dt { font-size: 13px; color: var(--muted); }
  .nums dd { margin: 0; font-size: 24px; font-weight: 600; letter-spacing: -0.03em; }
  .depth { display: flex; flex-direction: column; gap: 8px; max-width: 460px; }
  .bar { display: flex; height: 6px; border-radius: 6px; overflow: hidden; gap: 3px; }
  .bar i { display: block; height: 6px; }
  .bar .d-core { background: var(--sage); } .bar .d-interview { background: var(--amber); } .bar .d-research { background: var(--plum); }
  .legend { display: flex; gap: 16px; flex-wrap: wrap; font-size: 12.5px; color: var(--muted); }
  .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .dot.core { background: var(--sage); } .dot.interview { background: var(--amber); } .dot.research { background: var(--plum); }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .mine { display: flex; flex-direction: column; gap: 8px; max-width: 460px; padding: 14px 16px; border-radius: 14px; background: var(--sage-soft); }
  .mine-top { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; color: var(--sage); }
  .mine .eyebrow { color: var(--sage); }
  .track { height: 6px; border-radius: 6px; background: color-mix(in srgb, var(--sage) 20%, transparent); }
  .track i { display: block; height: 6px; border-radius: 6px; background: var(--sage); width: 0; transition: width .6s; }
  .cover-wrap { border-radius: 24px; overflow: hidden; border: 1px solid var(--line); }

  .body { display: grid; grid-template-columns: 320px minmax(0, 1fr); gap: 40px; align-items: start; padding-top: 40px; }
  .rail { position: sticky; top: 88px; display: flex; flex-direction: column; gap: 14px; max-height: calc(100vh - 104px); overflow-y: auto; padding-bottom: 8px; scrollbar-width: thin; }
  .box { padding: 16px 18px; display: flex; flex-direction: column; gap: 8px; }
  .mods-nav ol { list-style: none; margin: 0; padding: 0; }
  .mods-nav a { display: grid; grid-template-columns: 26px minmax(0, 1fr) auto; gap: 8px; align-items: baseline; padding: 8px 8px; margin: 0 -8px; border-radius: 9px; font-size: 14px; }
  .mods-nav a:hover { background: var(--sunk); color: var(--fg); }
  .mods-nav .n { font-size: 11.5px; color: var(--c); }
  .mods-nav .c { font-size: 11.5px; color: var(--muted); }
  .mods-nav .c.full, .mprog.full { color: var(--sage); }
  .plain { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 14px; }
  .plain a { color: var(--accent); }
  .next { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px; border-radius: var(--r-lg); background: var(--deep); color: var(--on-deep); border: 1px solid var(--line); }
  .next:hover { color: var(--on-deep); opacity: .92; }
  .ac { color: var(--deep-accent); }
  .ntitle { font-size: 17px; font-weight: 600; letter-spacing: -0.02em; }

  .main { display: flex; flex-direction: column; gap: 48px; min-width: 0; }
  .main h2 { font-size: 24px; margin-bottom: 16px; }
  .outs { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 28px; }
  .outs li { display: flex; gap: 12px; font-size: 15.5px; line-height: 1.5; padding: 4px 0; }
  .outs svg { color: var(--sage); flex: none; margin-top: 2px; }
  .syl-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .link-btn { background: none; border: 0; color: var(--accent); font-size: 14px; font-weight: 500; cursor: pointer; padding: 4px 0; }
  .mod { margin-bottom: 12px; overflow: hidden; scroll-margin-top: 90px; }
  .mod summary { list-style: none; display: flex; align-items: center; gap: 16px; padding: 18px 20px; cursor: pointer; }
  .mod summary::-webkit-details-marker { display: none; }
  .mod summary:hover .mtitle { color: var(--accent); }
  .mnum { color: var(--c); font-size: 13px; width: 24px; }
  .mtitle { flex: 1; font-size: 18px; font-weight: 600; letter-spacing: -0.02em; display: flex; flex-direction: column; gap: 3px; }
  .mmeta { font-size: 13px; color: var(--muted); font-weight: 400; letter-spacing: 0; }
  .mprog { font-size: 12px; color: var(--muted); background: var(--sunk); border-radius: 999px; padding: 3px 9px; }
  .chev { color: var(--muted); transition: transform .2s; flex: none; }
  .mod[open] .chev { transform: rotate(180deg); }
  .lessons { list-style: none; margin: 0; padding: 0; }
  .lrow { display: grid; grid-template-columns: 14px 36px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 12px 20px; border-top: 1px solid var(--line-soft); font-size: 15px; }
  .lrow:hover { background: var(--sunk); color: var(--fg); }
  .lrow:hover .ltitle { color: var(--accent); }
  .status { width: 12px; height: 12px; border-radius: 50%; border: 1.5px solid var(--line); }
  .lrow[data-status='learning'] .status { border-color: var(--sage); background: conic-gradient(var(--sage) 0 50%, transparent 0); }
  .lrow[data-status='done'] .status { border-color: var(--sage); background: var(--sage); }
  .lrow[data-status='review'] .status { border-color: var(--amber); background: var(--amber); }
  .lrow[data-status='done'] .ltitle { color: var(--muted); }
  .lnum { font-size: 12px; color: var(--muted); }
  .tags { display: flex; gap: 8px; align-items: center; }
  .anim { width: 22px; height: 22px; border-radius: 6px; display: grid; place-items: center; background: var(--sunk); color: var(--muted); }
  .mres { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; padding: 18px 20px 14px; border-top: 1px solid var(--line-soft); background: color-mix(in srgb, var(--sunk) 55%, var(--surface)); }
  .mres .eyebrow { display: block; margin-bottom: 4px; }

  @media (max-width: 1000px) {
    .body { grid-template-columns: minmax(0, 1fr); }
    .rail { position: static; max-height: none; order: 2; }
    .mods-nav { display: none; }
    .main { order: 1; }
  }
  @media (max-width: 760px) {
    .hdr, .outs, .mres { grid-template-columns: minmax(0, 1fr); }
    .hdr { gap: 28px; padding-block: 40px; }
    .lrow { grid-template-columns: 14px 32px minmax(0, 1fr); }
    .tags { display: none; }
  }
</style>
