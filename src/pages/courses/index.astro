---
import Base from '../../layouts/Base.astro';
import CourseCard from '../../components/CourseCard.astro';
import { allCourses, CATEGORIES } from '../../lib/courses';

const courses = await allCourses();
const cats = [...new Set(courses.map((c) => c.category))];
---
<Base title="Courses" description="Every course in the learning hub, from linear algebra to ML system design.">
  <div class="wrap page" data-pagefind-ignore>
    <header class="head">
      <span class="eyebrow">Catalogue</span>
      <h1>Courses</h1>
      <p class="muted">Each lesson is tagged by depth: <span class="chip d-core">core</span> must do, <span class="chip d-interview">interview</span> must explain, <span class="chip d-research">research</span> proofs and papers.</p>
    </header>
    <div class="filters" role="group" aria-label="Filter by category">
      <button type="button" class="f on" data-f="all" aria-pressed="true">All</button>
      {cats.map((c) => <button type="button" class="f" data-f={c} aria-pressed="false">{CATEGORIES[c]}</button>)}
    </div>
    <div class="cards" id="cards">
      {courses.map((c) => <CourseCard course={c} />)}
    </div>
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.f');
  const cards = document.querySelectorAll<HTMLElement>('#cards > a');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.f;
      buttons.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
      cards.forEach((c) => (c.hidden = f !== 'all' && c.dataset.category !== f));
    }),
  );
</script>

<style>
  .page { padding-block: 64px; }
  .head { display: flex; flex-direction: column; gap: 12px; margin-bottom: 28px; }
  h1 { font-size: 48px; letter-spacing: -0.045em; }
  .head p { font-size: 15px; max-width: 60ch; line-height: 1.9; }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 26px; }
  .f { font-size: 13px; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); min-height: 36px; cursor: pointer; }
  .f.on { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 900px) { .cards { grid-template-columns: minmax(0, 1fr); } }
  @media (min-width: 600px) and (max-width: 900px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
